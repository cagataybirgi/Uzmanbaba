{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173
    },
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "backend", "run", "dev"],
      "port": 4000
    },
    {
      "name": "backend-testdb",
      "runtimeExecutable": "node",
      "runtimeArgs": ["backend/node_modules/tsx/dist/cli.mjs", "--env-file=backend/.env.testdb.local", "backend/src/index.ts"],
      "port": 4000
    }
  ]
}
