# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Public origin of THIS backend, used to build absolute URLs for uploaded
# assets (e.g. avatars) in API responses. No trailing slash.
PUBLIC_BASE_URL="http://localhost:4000"

# ─── Database ────────────────────────────────────────────────────────────────
# Postgres connection string. For local dev with docker:
#   docker run --name uzmanbaba-pg -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d postgres:16
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/uzmanbaba?schema=public"

# Neon only: migrations need a DIRECT (unpooled) connection — the PgBouncer
# pooler can't run them reliably. Set this to the same DB via Neon's unpooled
# host (your DATABASE_URL without the "-pooler" part), then uncomment the
# `directUrl` line in prisma/schema.prisma. Runtime queries still use the
# pooled DATABASE_URL above.
# DIRECT_DATABASE_URL="postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Separate database for `npm test`. Must not point at the dev DB — the test
# harness truncates every table between tests.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/uzmanbaba_test?schema=public"

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN=7d

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call the API from a browser.
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"

# ─── Proxy ───────────────────────────────────────────────────────────────────
# Number of reverse-proxy hops to trust for the client IP (rate-limit keying).
# 0 = trust nobody (safe default for direct exposure). Set to 1 when running
# behind exactly one proxy (Nginx, fly.io, Railway, etc.).
TRUST_PROXY=0

# ─── Email (optional) ────────────────────────────────────────────────────────
# Leave SMTP_HOST empty to log codes/links to the console instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="UzmanBaba <no-reply@uzmanbaba.com>"

# Where the password-reset link points. Used inside reset emails.
APP_URL="http://localhost:5173"
